{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "planispherium-nova-mcp",
      "version": "0.1.0",
      "title": "Planispherium Nova MCP"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the geospatial services offered by Planispherium Nova (cartography, GIS, remote sensing, environmental consulting).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List portfolio projects",
        "description": "List cartography and GIS portfolio projects, including their title, description, and technologies used.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_gallery",
        "title": "List illustration gallery",
        "description": "List the naturalist illustration gallery entries (entomology / botany) with title and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_layers",
        "title": "List GIS layers",
        "description": "List the catalog of available GIS map layers (.shp, .kml, .kmz, .geojson). Optionally filter by layer type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tipo": {
              "description": "Optional layer type to filter by (e.g. shp, kml, kmz, geojson).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "submit_contact_request",
        "title": "Submit a contact / DEM request",
        "description": "Send a contact message or DEM processing request to Planispherium Nova. Use this to request a DEM clip, contour lines, or geospatial services for an area.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Full name of the person making the request."
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Contact email address."
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "Details of the request or message."
            },
            "company": {
              "description": "Company or organization (optional).",
              "type": "string"
            },
            "phone": {
              "description": "Phone number (optional).",
              "type": "string"
            },
            "contourInterval": {
              "description": "Desired contour line separation in meters (default 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "name",
            "email",
            "message"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
